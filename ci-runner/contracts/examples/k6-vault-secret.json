{
  "contract_version": 1,
  "run": {
    "tool": "k6",
    "trigger": "manual",
    "profile": "qg",
    "smoke": "never",
    "name": "QG со секретом из Vault"
  },
  "scenario": {
    "source": "git",
    "path": "scenarios/payments-api/qg.js"
  },
  "target": {
    "repository": "payments-api",
    "base_url": "https://payments.test.corp.local",
    "environment": "test"
  },
  "load": {
    "duration_sec": 600
  },
  "resources": {
    "cpu": "1",
    "memory": "2Gi",
    "replicas": 1
  },
  "sla": {
    "p95_ms": 300,
    "error_rate_pct": 1.0
  },
  "secrets": [
    {
      "name": "TOKEN",
      "vault": "loadtest/payments/TOKEN@kv"
    }
  ]
}

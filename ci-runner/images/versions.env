# Единственный источник версий образов контура НТ. Меняется только через MR:
# смена версии инструмента меняет baseline, и прогоны до/после несравнимы.
#
# *_IMAGE — ссылки строго по digest манифеста linux/amd64.
# Тег рядом с digest — для человека, pull идёт по digest.
# Сейчас это публичные образы для локальной сборки. В кластере тот же digest
# берётся из корпоративного прокси: содержимое слоя не меняется.

REGISTRY=localhost/lt
PLATFORM=linux/amd64

# glibc обязателен: Temurin и k6 собраны под glibc.
BASE_IMAGE=ubuntu:24.04@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b

JRE21_IMAGE=eclipse-temurin:21-jre@sha256:80b6aebe2f990697ada73fdbe451c7e9ec5e4adbde7a1e3625bc665e3b2fc06e
JDK17_IMAGE=eclipse-temurin:17-jdk@sha256:da9ed90d6eb4b5cc93a31f216a7227137fb95edeea9f7065d9ef3841c93a4538
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17@sha256:82e47241881f23ad774f5db8829efca15758e8fdb5b1d64ea9f8d6420a85068e
K6_IMAGE=grafana/k6:1.0.0@sha256:72f3a1dc3499819a5c608883f46e4ad8f464ba433969c45bcc97500f7e6a58dc
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.10.0@sha256:0fa384f2a6171aef8aab2999a531c8c8158727d54a8f20157a5c3c51a734d6b2

TINI_VERSION=0.19.0
TINI_URL=https://github.com/krallin/tini/releases/download/v0.19.0/tini-amd64
TINI_SHA256=93dcc18adc78c65a028a84799ecf8ad40c936fdfc5f2a57b1acda5a8117fa82c

JMETER_VERSION=5.6.3
JMETER_URL=https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-5.6.3.tgz
JMETER_SHA512=5978a1a35edb5a7d428e270564ff49d2b1b257a65e17a759d259a9283fc17093e522fe46f474a043864aea6910683486340706d745fcdf3db1505fd71e689083

# Taurus — только для JMeter (гибридная схема): k6 и Gatling запускаются нативно.
BZT_VERSION=1.17.1

# Должны совпадать с pom.xml, который генерирует портал (gatling-generator):
# образ собирается с прогретым ~/.m2 и запускает Maven офлайн.
GATLING_VERSION=3.13.5
GATLING_MAVEN_PLUGIN_VERSION=4.16.3

PIP_INDEX_URL=https://pypi.org/simple

# Ревизия сборки: растёт при изменении образа без смены версии инструмента.
REVISION=1
